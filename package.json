{
  "name": "ragnarok-idle",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "assets:sync": "node tools/sync-ro-assets.mjs",
    "assets:verify": "node tools/verify-ro-assets.mjs",
    "catalog:sync": "node tools/sync-ragnarok-db.mjs",
    "catalog:sprites": "node tools/sync-full-sprites.mjs",
    "catalog:sprites:items": "node tools/sync-full-sprites.mjs --items-only",
    "catalog:sprites:monsters": "node tools/sync-full-sprites.mjs --monsters-only",
    "catalog:verify": "node tools/verify-full-catalog.mjs",
    "progression:verify": "node tools/verify-progression.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "yaml": "^2.9.1"
  }
}